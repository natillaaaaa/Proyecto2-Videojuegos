# Copie este archivo como .env (NO lo suba a GitHub) y complete los valores.

# Cadena de conexión de MongoDB Atlas (Connect > Drivers)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos (opcional)
MONGODB_DB=catalogo_videojuegos

# Clave secreta para firmar los JWT: una cadena larga y aleatoria
JWT_SECRETO=cambie-esto-por-una-clave-larga-y-aleatoria

# Duración del token (opcional): 30m, 2h, 1d...
JWT_EXPIRACION=2h
